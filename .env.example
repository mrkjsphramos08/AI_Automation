# ==========================================
# n8n General Configuration
# ==========================================
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/

# ==========================================
# Security
# ==========================================
# 32+ character random hex string used by n8n to encrypt stored credentials
N8N_ENCRYPTION_KEY=replace_with_your_n8n_encryption_key

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_DB=n8n

# ==========================================
# AI Provider API Keys (Optional reference)
# ==========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=
